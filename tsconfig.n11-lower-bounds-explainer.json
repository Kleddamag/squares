{
  // The explainer's classic page scripts were legacy inline programs until PR #181.
  // They now live in files and inherit the shared floor. `think-4ylo` tracks removing
  // the four legacy inference relaxations after their DOM contracts gain full JSDoc.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "packing/devtools/n11-lower-bounds-explainer/**/*.js",
    "packing/devtools/n11-lower-bounds-explainer/**/*.d.ts",
    "packing/devtools/probes/compare_math_fonts/types.d.ts",
    "packing/devtools/probes/n11-lower-bounds-explainer.d.ts",
    "packing/devtools/probes/math/types.d.ts"
  ]
}
