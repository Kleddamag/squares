SquarePacking.Bentz.bentz_of_valid7 : SquarePacking.Bentz.Valid7 →
  ∀ (k : ℕ), 6 ≤ k → SquarePacking.minSide (k ^ 2 - 3) = ↑k
def SquarePacking.Bentz.Valid7 : Prop :=
∀ (c : ℝ × ℝ) (θ : ℝ),
  SquarePacking.sq c θ 1 ⊆ SquarePacking.box 7 → 1 ≤ SquarePacking.Bentz.box7Cover.measure (SquarePacking.sq c θ 1)
def SquarePacking.minSide : ℕ → ℝ :=
fun n => sInf {s | SquarePacking.Packs n s}
def SquarePacking.Packs : ℕ → ℝ → Prop :=
fun n s =>
  ∃ ctr ang,
    (∀ (i : Fin n), SquarePacking.sq (ctr i) (ang i) 1 ⊆ SquarePacking.box s) ∧
      ∀ (i j : Fin n), i ≠ j → Disjoint (SquarePacking.sqInt (ctr i) (ang i) 1) (SquarePacking.sqInt (ctr j) (ang j) 1)
